# ---- Trading mode & safety gates (MANDATORY) --------------------------------
# Default is paper. Live trading requires ALL THREE gates to be set:
#   TRADING_MODE=live AND ALLOW_LIVE_TRADING=true AND confirm_live=True in code.
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
# When true, the venue factory refuses live trading unconditionally (public demo).
PUBLIC_DEMO=true

# ---- HITL (human-in-the-loop) -----------------------------------------------
# Paper ignores this flag (no capital is moved). Live enforces it: with HITL=true
# every order is a proposal that needs explicit human confirmation before submit.
HITL=true

# ---- Venue ------------------------------------------------------------------
# paper (simulated wallet, default) | cex (Kraken/Coinbase keys) | onchain (RPC+signer)
VENUE=paper

# ---- CEX keys (only needed for VENUE=cex; live is hard-gated) ----------------
# Never commit real keys. Use GitHub Actions secrets or a local secrets store outside the repo.
KRAKEN_API_KEY=
KRAKEN_SECRET_KEY=
COINBASE_API_KEY=
COINBASE_SECRET_KEY=

# ---- On-chain (only needed for VENUE=onchain; live is hard-gated) -----------
# A signer/RPC is NEVER a plaintext private key on a VPS. Use a dedicated hot
# wallet with minimal funds or a KMS/hardware signer.
ONCHAIN_RPC_URL=

# ---- JEV judgment layer (Fase 3; TypeSafe "System One" model) ---------------
# Route is re-evaluated periodically (see PLAN §11). OpenRouter or direct.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev

# ---- Paper loop -------------------------------------------------------------
# Which experiment arm the loop runs, and which judge it uses (rules = offline).
PAPER_ARM=A
PAPER_JUDGE=rules

# ---- Storage ----------------------------------------------------------------
# Committed path: the loop appends decisions here and pushes.
JOURNAL_PATH=journal/decisions.jsonl
